{
  "name": "@better-auth/dsql-adapter",
  "version": "1.8.0-beta.3",
  "description": "Amazon Aurora DSQL adapter for Better Auth",
  "type": "module",
  "license": "MIT",
  "homepage": "https://www.better-auth.com/docs/adapters/postgresql",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/better-auth/better-auth.git",
    "directory": "packages/dsql-adapter"
  },
  "keywords": [
    "auth",
    "kysely",
    "adapter",
    "typescript",
    "better-auth",
    "aurora-dsql"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint:package": "publint run --strict --pack false",
    "lint:types": "attw --profile esm-only --pack .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "coverage": "vitest run --coverage --coverage.provider=istanbul"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "dev-source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./migration": {
      "dev-source": "./src/migration.ts",
      "types": "./dist/migration.d.mts",
      "default": "./dist/migration.mjs"
    }
  },
  "peerDependencies": {
    "@better-auth/core": "workspace:^",
    "@better-auth/kysely-adapter": "workspace:^",
    "better-auth": "workspace:^",
    "kysely": "catalog:"
  },
  "devDependencies": {
    "@better-auth/core": "workspace:*",
    "@better-auth/kysely-adapter": "workspace:*",
    "better-auth": "workspace:*",
    "kysely": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
